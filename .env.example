# Application and background-job settings. Do not change these for Docker.
APP_NAME=Document Research Assistant
APP_ENV=development
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
LOG_FILE=data/logs/assistant.log

# MODEL ROUTER: used only when an API request does not specify "provider".
DEFAULT_MODEL_PROVIDER=openai

# OpenAI route. Fill this key once.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9

# RAG embeddings and persistent local vector database.
# Embeddings intentionally use OpenAI even if chat is routed to vLLM.
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_DIR=data/chroma
RETRIEVAL_TOP_K=4

# vLLM route. Configure once; select it per request with "provider": "vllm".
# For vLLM in this Docker Compose project, retain http://vllm:8000/v1.
# For vLLM on Colab via ngrok, replace this with https://YOUR-NGROK-URL/v1.
VLLM_BASE_URL=http://vllm:8000/v1
# Needed only when your remote vLLM (for example, Colab) was started with --api-key.
VLLM_API_KEY=

# Used only by the optional Docker vLLM service (--profile vllm).
VLLM_MODEL=Qwen/Qwen3-0.6B
VLLM_SERVED_MODEL_NAME=local-qwen
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_MODEL_LEN=4096
# Leave blank for public models; fill only when using a gated Hugging Face model.
HF_TOKEN=
